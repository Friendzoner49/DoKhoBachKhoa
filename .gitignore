# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Local data (generated, never committed; the whole point is it only
# lives on this machine — see CLAUDE.md)
data/
*.sqlite
*.sqlite3
*.db

# Generated export, regenerated by shop.tools.export_public; site/index.html
# is a dev-only local-preview copy of src/shop/site_template/index.html;
# site/images is a dev-only local-preview copy of K:\705bot-site/images
site/products.json
site/index.html
site/images/

# PyInstaller build output
packaging/build/
packaging/dist/
build/
dist/
*.spec.bak

# shop.ui.app.self_test()'s default output dir (SHOP_SELFTEST_OUT unset) --
# dev-only, regenerated by `uv run shop-app --self-test`
selftest-output/

# Secrets
.env
*.env
config.local.json

# A photo dropped at the repo root for Claude to read (e.g. a supplier
# invoice) -- these carry real business/personal data and belong in
# data/supplier_invoices/, not history. Scoped to the root only: this
# must never hide images that belong elsewhere in the tree on purpose
# (there are none right now, but don't let a future one get swallowed).
/*.jpg
/*.jpeg
/*.png

# OS
.DS_Store
Thumbs.db

# Claude Code's own local session state, not project content
.claude/
